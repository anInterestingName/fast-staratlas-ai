APP_NAME=fast-staratlas-ai
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
# 打印 HTTP 入参和响应。开发可 true，生产默认 false
HTTP_LOG=false
API_V1_PREFIX=/api/v1
# PostgreSQL SQLAlchemy URL（psycopg）。以下为本地示例，不要填写真实生产凭据
DATABASE_URL=postgresql+psycopg://admin:123456@127.0.0.1:5432/fast_staratlas_ai

# LLM 完整配置项文件。密钥写在该 YAML 的各配置项 apikey 中，示例文件保持为空。
LLM_CONFIG=config/llm.yaml
